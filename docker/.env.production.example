# Copy this file to docker/.env.production and restrict it to the server owner:
#   cp docker/.env.production.example docker/.env.production
#   chmod 600 docker/.env.production

COMPOSE_PROJECT_NAME=norish

# Build and host identity
NORISH_IMAGE=norish-local
NORISH_TAG=latest
PUID=1000
PGID=1000
YT_DLP_VERSION=2026.02.04

# Bind to loopback when using a reverse proxy. Use 0.0.0.0 for direct LAN access.
NORISH_BIND_ADDRESS=127.0.0.1
NORISH_PORT=3000

# Public URL used by authentication. Do not add a trailing slash.
AUTH_URL=https://recipes.example.com
TRUSTED_ORIGINS=https://recipes.example.com

# Generate once and keep both values with your backups.
# POSTGRES_PASSWORD: openssl rand -hex 24
# MASTER_KEY:         openssl rand -base64 32
POSTGRES_DB=norish
POSTGRES_USER=norish
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
MASTER_KEY=replace-with-a-base64-key-of-at-least-32-characters

# Initial sign-in policy. Registration can be enabled temporarily for setup.
PASSWORD_AUTH_ENABLED=true
ENABLE_REGISTRATION=false

# Retention for completed groceries and old calendar records.
SCHEDULER_CLEANUP_MONTHS=3

# Override these only when deliberately pinning or upgrading infrastructure.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8.6.0
CHROME_IMAGE=zenika/alpine-chrome:latest
